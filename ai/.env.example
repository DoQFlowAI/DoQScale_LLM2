# 로컬 개발용 예시. 복사해서 .env로 쓰고, 키 값만 채운다. (.env는 커밋하지 않음)
# 값을 비워 두면 빈 문자열로 읽혀 기본값을 덮어쓰므로, 쓰지 않는 항목은 줄째 지우거나 주석으로 둔다.

# 모델 (개발·배포 모두 OpenAI)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=800
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# 키
OPENAI_API_KEY=
AI_INTERNAL_KEY=            # 16자 이상. Backend와 같은 값
# GROQ_API_KEY=             # LLM_PROVIDER=groq 로 바꿀 때만

# 경로 (로컬 기본값 ./faiss, ./uploads. Docker 이미지는 /app/faiss, /app/uploads로 고정)
# VECTOR_STORE_DIR=./faiss
# UPLOAD_DIR=./uploads

# RAG (기준값은 질문셋 평가로 확정, 명세서 10.2)
RAG_TOP_K=5
RAG_FETCH_K=100
RAG_SCORE_THRESHOLD=0.20
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# 개발 편의: true면 /docs(Swagger) 켬. 배포에서는 false
ENABLE_DOCS=false

# LangSmith는 이 파일로 켜지지 않는다 (앱 설정이 아니라 셸 환경변수로 읽음). 배포에서는 끔
