# 모델 선택
LLM_PROVIDER=
LLM_MODEL=
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=800
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=

# 키 (값은 절대 넣지 않음)
GROQ_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434   
AI_INTERNAL_KEY=

# 경로
VECTOR_STORE_DIR=/app/faiss
UPLOAD_DIR=/app/uploads

# RAG
RAG_TOP_K=5
RAG_FETCH_K=100
RAG_SCORE_THRESHOLD=0.20
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# 관측 (개발만)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=

# 개발 편의
ENABLE_DOCS=false